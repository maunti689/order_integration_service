ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://orders:local-only-orders@postgres:5432/orders
CELERY_BROKER_URL=amqp://orders:local-only-orders@rabbitmq:5672//
PROVIDER_BASE_URL=http://provider-mock:8081
PROVIDER_API_KEY=local-only-provider-key
PROVIDER_WEBHOOK_SECRET=local-only-webhook-secret
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_MAX_RETRIES=4
API_KEY_SALT=local-only-api-key-salt
ADMIN_API_KEY=local-only-admin-key
OUTBOX_BATCH_SIZE=50
PROVIDER_FAIL_FIRST_ATTEMPTS=0
